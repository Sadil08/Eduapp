# Backend environment template — copy to `.env` and fill in real values.
# `.env` is gitignored and MUST NOT be committed. Never put real secrets in this example file.
#
# SECURITY: the previously committed .env exposed live credentials. Every value below
# must be ROTATED (regenerated in the provider console) before any deployment — see
# ../AUDIT_RESPONSE.md (WP-A0.1). Rotating only changes the values; the leaked ones in
# git history must also be purged (git filter-repo / BFG) and force-pushed.

# --- Database (PostgreSQL) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/eduapp_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=password

# --- JWT signing secret (must be >= 32 bytes; app fails fast otherwise) ---
JWT_SECRET=generate_a_long_random_string_at_least_32_bytes

# --- Frontend origin(s) for CORS (comma-separated, no wildcard in prod) ---
FRONTEND_URL=http://localhost:3000

# --- Mail (Gmail SMTP app password) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# --- Supabase S3-compatible storage ---
SUPABASE_S3_ENDPOINT=https://<project>.supabase.co/storage/v1/s3
SUPABASE_S3_ACCESS_KEY=your_supabase_s3_access_key
SUPABASE_S3_SECRET_KEY=your_supabase_s3_secret_key
SUPABASE_BUCKET_NAME=eduapp-images
SUPABASE_PROJECT_URL=https://<project>.supabase.co

# --- AI / Vertex (used by the Python extraction service; keep out of VCS) ---
GEMINI_API_KEY=your_gemini_api_key

# --- AI extraction service (Python) ---
# SEC-1: shared secret. The backend sends it as X-API-Key; the Python service must be started
# with SERVICE_API_KEY set to the SAME value (comma-separated for rotation). Leave the Python
# service unreachable from the public internet (bind 127.0.0.1 / private network / firewall).
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=generate_a_long_random_shared_secret

# --- GCP (backend Vertex access). Leave GCP_CREDENTIALS_PATH empty to use Application
#     Default Credentials (GCP metadata / GOOGLE_APPLICATION_CREDENTIALS). ---
GCP_PROJECT_ID=your_gcp_project_id
GCP_LOCATION=asia-south1
GCP_CREDENTIALS_PATH=

# PayHere (payments, USD). Sandbox credentials come from your PayHere merchant account.
# PAYHERE_NOTIFY_URL must be reachable from the internet (use a tunnel such as ngrok locally).
PAYHERE_MERCHANT_ID=CHANGE_ME
PAYHERE_MERCHANT_SECRET=CHANGE_ME
PAYHERE_SANDBOX=true
PAYHERE_NOTIFY_URL=https://your-public-host/api/payments/payhere/notify
